{
  "archive_file": "temp/archive.txt",
  "input_file": "input.csv",
  "output_dir": "output/",
  "log_dir": "logs/",
  "temp_dir": "temp/",
  "download_cmd": [
    "yt-dlp", 
    "-o", 
    "{output}.%(ext)s", 
    "--download-archive", "{archive}",
    "-x", 
    "-f", "bestaudio", 
    "{url}"
  ],
  "convert_cmd": [
    "ffmpeg", 
    "-hide_banner",
    "-i", "{input}",
    "-c:a", "libopus",
    "-b:a", "128k",
    "{output}"
  ],
  "metadata_cmd": [
    "ffmpeg", 
    "-nostdin", 
    "-hide_banner",
    "-y", 
    "-i", "{input}",
    "-c:a", "copy", 
    "-metadata", "title={title}",
    "-metadata", "artist={author}",
    "{output}"
  ],
  "sleep": 1
}
